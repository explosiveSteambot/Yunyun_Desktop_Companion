<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent part: physics, rendering, settings, geometry.
       No Windows APIs here, so it builds and its tests run on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YunYun.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YunYun.Core.Tests" />
  </ItemGroup>

</Project>
